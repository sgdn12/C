#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

enum Menu { COFFEE = 1, TEA, JUICE };

int getPrice(enum Menu m) {
    switch (m) {
        case COFFEE: return 3000;
        case TEA:    return 2500;
        case JUICE:  return 3500;
    }
    return 0;
}

int main(void) {
    int choice;
    int count;

    printf("1.Coffee  2.Tea  3.Juice\n");
    printf("메뉴 번호: ");
    scanf("%d", &choice);
    printf("수량: ");
    scanf("%d", &count);

    enum Menu order = (enum Menu)choice;
    int price = getPrice(order);

    if (price == 0)
        printf("없는 메뉴입니다.\n");
    else
        printf("합계: %d원\n", price * count);

    return 0;
}
