
#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100];
    char str2[100];

    printf("첫 번째 문자열 입력: ");
    fgets(str1, sizeof(str1), stdin);

    printf("두 번째 문자열 입력: ");
    fgets(str2, sizeof(str2), stdin);

    str1[strcspn(str1, "\n")] = '\0';
    str2[strcspn(str2, "\n")] = '\0';

    printf("\n첫 번째 문자열 길이: %d\n", (int)strlen(str1));
    printf("두 번째 문자열 길이: %d\n", (int)strlen(str2));

    if (strcmp(str1, str2) == 0)
    {
        printf("두 문자열은 같습니다.\n");
    }
    else
    {
        printf("두 문자열은 다릅니다.\n");
    }

    return 0;
}
