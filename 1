#include <stdio.h>
#include <stdlib.h>

int main() {
    int size = 5;
    int *numPtr = NULL;

    numPtr = (int *)malloc(sizeof(int) * size);

    if (numPtr == NULL) {
        printf("메모리 할당에 실패했습니다!\n");
        return 1;
    }

    for (int i = 0; i < size; i++) {
        numPtr[i] = (i + 1) * 10;
    }

    printf("--- 동적 메모리 배열 값 출력 ---\n");
    for (int i = 0; i < size; i++) {
        printf("numPtr[%d] = %d\n", i, numPtr[i]);
    }

    free(numPtr);
    numPtr = NULL;

    printf("메모리가 안전하게 해제되었습니다.\n");

    return 0;
}
